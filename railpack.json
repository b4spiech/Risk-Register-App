{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12",
    "node": "20"
  },
  "steps": {
    "frontend": {
      "inputs": [
        { "step": "install" },
        {
          "local": true,
          "include": [
            "package.json",
            "package-lock.json",
            "tsconfig.json",
            "vite.config.ts",
            "index.html",
            "src"
          ]
        }
      ],
      "commands": [
        "npm ci",
        "npm run build"
      ]
    }
  },
  "deploy": {
    "inputs": [
      { "step": "frontend" },
      {
        "local": true,
        "include": ["app"]
      }
    ],
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
